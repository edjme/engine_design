{
  // Общие предпочтения редактора
  "editor.formatOnSave": true,
  "files.trimTrailingWhitespace": true,

  // Подсветка и ассоциации для стандартных заголовков
  "files.associations": {
    "*.ipp": "cpp",
    "*.tcc": "cpp",
    "cmath": "cpp",
    "cstdint": "cpp",
    "cstdio": "cpp",
    "cstdlib": "cpp",
    "cstring": "cpp",
    "array": "cpp",
    "vector": "cpp",
    "string": "cpp",
    "string_view": "cpp",
    "initializer_list": "cpp",
    "utility": "cpp",
    "type_traits": "cpp",
    "algorithm": "cpp",
    "fstream": "cpp",
    "sstream": "cpp",
    "iostream": "cpp"
  },

  // C/C++: стандарты и includePath на всякий случай (дублирует c_cpp_properties)
  "C_Cpp.default.cppStandard": "c++20",
  "C_Cpp.default.cStandard": "c17",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}",
    "${workspaceFolder}/input_data",
    "${workspaceFolder}/Calculations"
  ],

  // Терминал стартует в корне проекта (важно для относительных путей ввода/вывода)
  "terminal.integrated.cwd": "${workspaceFolder}"
}