{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug kinematic (Windows, MinGW gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\build\\kinematic.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "C:\\msys64\\mingw64\\bin\\gdb.exe",
      "setupCommands": [
        {
          "text": "-enable-pretty-printing"
        }
      ],
      "preLaunchTask": "Build kinematic.exe"
    },
    {
      "name": "Debug ind_diag (Windows, MinGW gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\build\\ind_diag.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "C:\\msys64\\mingw64\\bin\\gdb.exe",
      "setupCommands": [
        {
          "text": "-enable-pretty-printing"
        }
      ],
      "preLaunchTask": "Build ind_diag.exe"
    },
    {
      "name": "Debug Palpha_Diagr (Windows, MinGW gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\Palpha_Diag.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "C:\\msys64\\mingw64\\bin\\gdb.exe",
      "setupCommands": [
        {
          "text": "-enable-pretty-printing"
        }
      ],
      "preLaunchTask": "Build Palpha_Diag.exe"
    },
    {
      "name": "Launch wx_app (external)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/wx_app.exe",
      "cwd": "${workspaceFolder}",
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Build wxWidgets GUI"
    }
  ]
}