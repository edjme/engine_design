{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug project (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/main.exe",
      "cwd": "${workspaceFolder}",
      "args": [],
      "MIMode": "gdb",
      "miDebuggerPath": "C:/mingw64/bin/gdb.exe",
      "externalConsole": true,          // ← вместо "console"
      "setupCommands": [
        { "text": "-enable-pretty-printing" }
      ],
      "preLaunchTask": "build:project (g++)"
    },
    {
      "name": "Debug active file (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}/${fileBasenameNoExtension}.exe",
      "cwd": "${fileDirname}",
      "args": [],
      "MIMode": "gdb",
      "miDebuggerPath": "C:/mingw64/bin/gdb.exe",
      "externalConsole": true,          // ← вместо "console"
      "setupCommands": [
        { "text": "-enable-pretty-printing" }
      ],
      "preLaunchTask": "build:active (g++)"
    }
  ]
}
