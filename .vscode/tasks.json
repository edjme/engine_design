{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build kinematic.exe",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++20",
        "-O2",
        "-g",
        "core/Kinematic/Calculations/kinematic/main_kinematic.cpp",
        "core/Kinematic/input_data/kinematic_input.cpp",
        "core/Kinematic/output_data/kinematic_output.cpp",
        "core/Kinematic/Calculations/kinematic/kinematic_formulas.cpp",
        "core/common/common_types.cpp",
        "path_manager.cpp",
        "-I.",
        "-ICalculations",
        "-o",
        "kinematic.exe",
        "-DUNICODE",
        "-D_UNICODE",
        "-finput-charset=UTF-8",
        "-fexec-charset=UTF-8",
        "-static",
        "-static-libgcc",
        "-static-libstdc++"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Сборка kinematic.exe"
    },
    {
      "label": "Build ind_diag.exe",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++20",
        "-O2",
        "-g",
        "core/IND_Diagr/calculations/ind_diagr_main.cpp",
        "core/IND_Diagr/input_data/ind_diag_input.cpp",
        "core/IND_Diagr/output_data/ind_diag_output.cpp",
        "core/IND_Diagr/calculations/calc_ind_diagr.cpp",
        "core/common/ind_diag_common_types.cpp",
        "ind_path_manager.cpp",
        "-I.",
        "-o",
        "ind_diag.exe",
        "-DUNICODE",
        "-D_UNICODE",
        "-finput-charset=UTF-8",
        "-fexec-charset=UTF-8",
        "-static",
        "-static-libgcc",
        "-static-libstdc++"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "detail": "Сборка ind_diag.exe"
    },
    {
      "label": "Build Palpha_Diag.exe",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++20",
        "-O2",
        "-g",
        "core/Diag_Palpha/Calculations/main_Palpha.cpp",
        "core/Diag_Palpha/Input_data/Palpha_input.cpp",
        "core/Diag_Palpha/Output_data/Palpha_output.cpp",
        "core/Diag_Palpha/Calculations/calc_Palpha.cpp",
        "ind_Palpha_path_manager.cpp",
        "core/common/common_types.cpp",
        "-I.",
        "-Icore/Diag_Palpha",
        "-Icore/Diag_Palpha/input_data",
        "-Icore/Diag_Palpha/output_data",
        "-Icore/Diag_Palpha/calculations",
        "-o",
        "Diag_Palpha.exe",
        "-DUNICODE",
        "-D_UNICODE",
        "-finput-charset=UTF-8",
        "-fexec-charset=UTF-8",
        "-static",
        "-static-libgcc",
        "-static-libstdc++"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "detail": "Сборка программы развертки индикаторной диаграммы (Diag_Palpha.exe)"
    }
  ]
}