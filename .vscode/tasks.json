{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build kinematic.exe",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "cd \"$(cygpath \"${workspaceFolder}\")\" && g++ -std=c++20 -O2 -g core/Kinematic/Calculations/kinematic/main_kinematic.cpp core/Kinematic/input_data/kinematic_input.cpp core/Kinematic/output_data/kinematic_output.cpp core/Kinematic/Calculations/kinematic/kinematic_formulas.cpp core/common/common_types.cpp path_manager.cpp -I. -o kinematic.exe -DUNICODE -D_UNICODE -finput-charset=UTF-8 -fexec-charset=UTF-8 -static -static-libgcc -static-libstdc++"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Сборка kinematic.exe"
    },
    {
      "label": "Build ind_diag.exe",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++20",
        "-O2",
        "-g",
        "${workspaceFolder}/core/IND_Diagr/calculations/ind_diagr_main.cpp",
        "${workspaceFolder}/core/IND_Diagr/input_data/ind_diag_input.cpp",
        "${workspaceFolder}/core/IND_Diagr/output_data/ind_diag_output.cpp",
        "${workspaceFolder}/core/IND_Diagr/calculations/calc_ind_diagr.cpp",
        "${workspaceFolder}/core/common/ind_diag_common_types.cpp",
        "${workspaceFolder}/ind_path_manager.cpp",
        "-I.",
        "-o",
        "ind_diag.exe",
        "-DUNICODE",
        "-D_UNICODE",
        "-finput-charset=UTF-8",
        "-fexec-charset=UTF-8",
        "-static",
        "-static-libgcc",
        "-static-libstdc++"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "detail": "Сборка ind_diag.exe"
    },
    {
      "label": "Build Palpha_Diag.exe",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++20",
        "-O2",
        "-g",
        "${workspaceFolder}/core/Diag_Palpha/Calculations/main_Palpha.cpp",
        "${workspaceFolder}/core/Diag_Palpha/Input_data/Palpha_input.cpp",
        "${workspaceFolder}/core/Diag_Palpha/Output_data/Palpha_output.cpp",
        "${workspaceFolder}/core/Diag_Palpha/Calculations/calc_Palpha.cpp",
        "${workspaceFolder}/ind_Palpha_path_manager.cpp",
        "${workspaceFolder}/core/common/common_types.cpp",
        "-I.",
        "-Icore/Diag_Palpha",
        "-Icore/Diag_Palpha/input_data",
        "-Icore/Diag_Palpha/output_data",
        "-Icore/Diag_Palpha/calculations",
        "-o",
        "Diag_Palpha.exe",
        "-DUNICODE",
        "-D_UNICODE",
        "-finput-charset=UTF-8",
        "-fexec-charset=UTF-8",
        "-static",
        "-static-libgcc",
        "-static-libstdc++"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "detail": "Сборка программы развертки индикаторной диаграммы (Diag_Palpha.exe)"
    },
    {
      "label": "Build wxWidgets GUI",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "cd \"$(cygpath \"${workspaceFolder}\")\" && g++ gui_wx/gui_main.cpp $(wx-config --cxxflags --libs) -o wx_app.exe -mthreads"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}