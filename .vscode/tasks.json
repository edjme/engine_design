{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C++ project",
            "type": "shell",
            "command": "g++",
            "args": [
                "main.cpp",
                "input_data/input.cpp",
                "-o",
                "main.exe",
                "-finput-charset=UTF-8",
                "-fexec-charset=UTF-8",
                "-I.",
                "-Iinput_data",
                "-ICalculations",
                "-g",
                "-lgdi32",
                "-lgdiplus",
                "-lcomctl32",
                "-lshell32",
                "-lole32",
                "-luuid",
                "-DUNICODE",
                "-D_UNICODE",
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Компиляция всех cpp файлов в main.exe"
        }
    ]
}