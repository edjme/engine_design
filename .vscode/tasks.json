{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build kinematic.exe",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++20",
        "-O2",
        "-g",
        "Kinematic/Calculations/kinematic/calc_kinematic.cpp",
        "Kinematic/input_data/kinematic_input.cpp",
        "Kinematic/output_data/kinematic_output.cpp",
        "common/common_types.cpp",
        "path_manager.cpp",
        "-I.",
        "-ICalculations",
        "-o",
        "kinematic.exe",
        "-DUNICODE",
        "-D_UNICODE",
        "-finput-charset=UTF-8",
        "-fexec-charset=UTF-8",
        "-static",
        "-static-libgcc",
        "-static-libstdc++"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Сборка kinematic.exe"
    }
  ]
}